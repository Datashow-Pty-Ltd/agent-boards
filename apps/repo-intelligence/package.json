  },
  "dependencies": {
    "express": "5.1.0",
    "tree-sitter": "0.21.1",
    "tree-sitter-typescript": "0.23.2",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@types/express": "5.0.5",
    "@types/node": "24.10.1",
    "tsx": "4.21.0",
    "typescript": "5.9.3"
  }
}
