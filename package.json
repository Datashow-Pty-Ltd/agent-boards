{
  "name": "agent-boards",
  "version": "0.1.0-alpha.1",
  "description": "Governed project record and delivery board for people and AI coding agents",
  "license": "Apache-2.0",
  "private": true,
  "homepage": "https://github.com/Datashow-Pty-Ltd/agent-boards#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Datashow-Pty-Ltd/agent-boards.git"
  },
  "bugs": {
    "url": "https://github.com/Datashow-Pty-Ltd/agent-boards/issues"
  },
  "engines": {
    "node": ">=22",
    "pnpm": ">=10.26 <11"
  },
  "packageManager": "pnpm@10.26.1",
  "pnpm": {
    "overrides": {
      "esbuild": "0.28.2",
      "minimatch": "11.0.1"
    }
  },
  "scripts": {
    "build": "pnpm --filter @agent-boards/web build && pnpm --filter @agent-boards/mcp build && pnpm --filter @agent-boards/repo-intelligence build",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "dev:web": "pnpm --filter @agent-boards/web dev",
    "dev:mcp": "pnpm --filter @agent-boards/mcp dev",
    "dev:intelligence": "pnpm --filter @agent-boards/repo-intelligence dev",
    "apple:build": "./scripts/stack.sh build",
    "apple:up": "./scripts/stack.sh up",
    "apple:down": "./scripts/stack.sh down",
    "apple:status": "./scripts/stack.sh status",
    "apple:logs": "./scripts/stack.sh logs",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up --build -d --wait",
    "docker:down": "docker compose down",
    "docker:status": "docker compose ps",
    "docker:logs": "docker compose logs --tail=100 -f",
    "test:live": "pnpm --filter @agent-boards/mcp test:live",
    "test:claude": "./scripts/claude-smoke.sh",
    "test:browser": "playwright test",
    "check:limits": "node scripts/check-source-limits.mjs",
    "audit:prod": "pnpm audit --prod --audit-level high",
    "security:secrets": "node scripts/scan-secrets.mjs",
    "security:sbom": "node scripts/generate-sbom.mjs",
    "security:licenses": "node scripts/check-licenses.mjs",
    "security:oss": "./scripts/security-oss.sh",
    "security:containers": "./scripts/scan-container-images.sh",
    "release:check": "pnpm lint && pnpm check:limits && pnpm typecheck && pnpm test && pnpm build && pnpm audit:prod && pnpm security:secrets",
    "release:verify": "node scripts/verify-release.mjs",
    "release:verify:public": "node scripts/verify-release.mjs --public",
    "release:archive": "./scripts/create-source-archive.sh",
    "certify": "pnpm release:check && pnpm security:licenses && pnpm security:sbom && pnpm release:archive && pnpm release:verify"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "typescript-eslint": "8.72.1"
  }
}
